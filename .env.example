# OpenCTI connection
OPENCTI_URL=
OPENCTI_TOKEN=
OPENCTI_VERIFY_TLS=true

# Public CTI sources
OTX_API_KEY=
OTX_BASE_URL=https://otx.alienvault.com
ABUSECH_API_KEY=
THREATFOX_BASE_URL=https://threatfox-api.abuse.ch

# Local Ollama inference
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# AI provider selection: ollama, openai, or groq
AI_PROVIDER=ollama
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Application
CTI_LOG_LEVEL=INFO
CTI_REQUEST_TIMEOUT=30
CTI_VERIFY_TLS=true

# Optional enrichment: activated only with CLI --enrich or MCP providers
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
CTI_ENRICHMENT_CACHE_TTL=3600
CTI_ENRICHMENT_RPM=4
CTI_RESTRICTED_DOMAINS=

# Authorized textual reports only; comma-separated owner/repo allowlist
GITHUB_TOKEN=
CTI_REPOSITORY_ALLOWLIST=
CTI_REPOSITORY_CHECKPOINT=/state/repositories.json
CTI_REPOSITORY_MAX_FILES=20
CTI_REPOSITORY_MAX_BYTES=100000

# DLP sanitization (Phase 12): redact PII before any LLM call or embedding
CTI_DLP_ENABLED=false
CTI_DLP_EMAIL_DOMAINS=
CTI_DLP_INTERNAL_CIDRS=
CTI_DLP_NAMES=
CTI_DLP_ALLOWED_VALUES=

# Detection as Code (Phase 11): PR export requires explicit authorization
CTI_DETECTION_PR_ALLOWLIST=

# Historical memory (Phase 13): disabled by default; local Qdrant + Ollama
CTI_MEMORY_ENABLED=false
CTI_MEMORY_URL=http://localhost:6333
CTI_MEMORY_COLLECTION=cti-memory
CTI_MEMORY_EMBEDDING_MODEL=nomic-embed-text
CTI_MEMORY_TENANT=default
CTI_MEMORY_REMOTE_EMBEDDINGS=false
CTI_MEMORY_RETENTION_DAYS=365

# SecOps automation (Phase 14): TheHive / Cortex XSOAR cases
CTI_THEHIVE_URL=
CTI_THEHIVE_TOKEN=
CTI_XSOAR_URL=
CTI_XSOAR_TOKEN=
CTI_SECOPS_RETRY_ATTEMPTS=2

# ChatOps notifications (Phase 14): name=url pairs; internal hosts need explicit consent
CTI_CHATOPS_WEBHOOKS=
CTI_CHATOPS_SECRETS=
CTI_SECOPS_ALLOWED_HOSTS=
