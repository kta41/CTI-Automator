# OpenCTI connection
OPENCTI_URL=
OPENCTI_TOKEN=
OPENCTI_VERIFY_TLS=true

# Public CTI sources
OTX_API_KEY=
OTX_BASE_URL=https://otx.alienvault.com
ABUSECH_API_KEY=
THREATFOX_BASE_URL=https://threatfox-api.abuse.ch

# Local Ollama inference
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# AI provider selection: ollama, openai, or groq
AI_PROVIDER=ollama
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Application
CTI_LOG_LEVEL=INFO
CTI_REQUEST_TIMEOUT=30
CTI_VERIFY_TLS=true

# Optional enrichment: activated only with CLI --enrich or MCP providers
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
CTI_ENRICHMENT_CACHE_TTL=3600
CTI_ENRICHMENT_RPM=4
CTI_RESTRICTED_DOMAINS=

# Authorized textual reports only; comma-separated owner/repo allowlist
GITHUB_TOKEN=
CTI_REPOSITORY_ALLOWLIST=
CTI_REPOSITORY_CHECKPOINT=/state/repositories.json
CTI_REPOSITORY_MAX_FILES=20
CTI_REPOSITORY_MAX_BYTES=100000
